---
interface Props {
  label: string;
  title: string;
}

const { label, title } = Astro.props;
---

<div data-reveal class="flex flex-wrap items-end justify-between gap-4">
  <div class="flex flex-col gap-2.5">
    <span class="font-mono text-[13px] font-medium tracking-[.08em] text-primary uppercase">{label}</span>
    <h2 class="m-0 font-display text-[32px] font-bold tracking-[-.03em] text-balance sm:text-[44px]">{title}</h2>
  </div>
  <slot />
</div>
