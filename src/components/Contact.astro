---
import { linkedin, github } from '../data/liens';

const email = 'dstndiaye@gmail.com';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section id="contact" class="mx-auto max-w-page px-5 pb-20 sm:px-8 sm:pb-24">
  <div data-reveal class="relative overflow-hidden rounded-block border border-line bg-white px-6 py-10 sm:px-12 sm:py-14">
    <div aria-hidden="true" class="absolute -top-40 -right-32 size-[520px] rounded-full bg-[radial-gradient(closest-side,rgba(47,91,255,.16),rgba(122,92,255,.08)_55%,rgba(255,255,255,0)_100%)]"></div>

    <div class="relative flex max-w-[760px] flex-col gap-7">
      <div class="flex flex-col gap-3">
        <span class="font-mono text-[13px] font-medium tracking-[.08em] text-primary uppercase">Contact</span>
        <h2 class="m-0 font-display text-[28px] leading-[1.15] font-bold tracking-[-.03em] text-balance sm:text-[40px]">
          Je cherche un CDI de Data Scientist, partout en France. Parlons de votre projet.
        </h2>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <a href={`mailto:${email}`} class="inline-flex min-h-12 min-w-0 items-center rounded-btn border border-line bg-bg px-4 font-mono text-[15px] break-all text-ink no-underline hover:text-primary sm:text-base">{email}</a>
        <button type="button" id="copier-email" data-email={email} class="js-only btn btn-ghost cursor-pointer">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>
          <span>Copier</span>
        </button>
        <span id="copier-statut" class="sr-only" aria-live="polite"></span>
      </div>

      <div class="flex flex-wrap gap-3">
        <a class="btn btn-main" href={`${base}CV_Serigne_Bassirou_NDIAYE.pdf`} download>Télécharger mon CV
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v12M6 11l6 6 6-6M5 20h14"></path></svg>
        </a>
        <a class="btn btn-ghost" href={linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (nouvel onglet)">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"></rect><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"></path></svg>
          LinkedIn
        </a>
        <a class="btn btn-ghost" href={github} target="_blank" rel="noopener noreferrer" aria-label="GitHub (nouvel onglet)">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"></path></svg>
          GitHub
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const bouton = document.getElementById('copier-email');
  const statut = document.getElementById('copier-statut');
  const libelle = bouton?.querySelector('span');
  let minuteur = 0;
  bouton?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(bouton.dataset.email ?? '');
      if (libelle) libelle.textContent = 'Copié';
      if (statut) statut.textContent = 'Copié';
      clearTimeout(minuteur);
      minuteur = window.setTimeout(() => {
        if (libelle) libelle.textContent = 'Copier';
        if (statut) statut.textContent = '';
      }, 2000);
    } catch {
      // Presse-papiers indisponible : l'e-mail reste sélectionnable et cliquable.
    }
  });
</script>
