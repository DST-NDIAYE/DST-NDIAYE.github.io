---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import SectionHeading from './SectionHeading.astro';

const projets = (await getCollection('projets')).sort((a, b) => a.data.ordre - b.data.ordre);
---

<section id="projets" class="mx-auto flex max-w-page flex-col gap-8 px-5 pb-20 sm:px-8 sm:pb-[88px]">
  <SectionHeading label="Projets" title="Ce que j'ai construit" />

  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(340px,100%),1fr))] gap-6">
    {projets.map((projet) => <ProjectCard projet={projet} />)}
  </div>
</section>
