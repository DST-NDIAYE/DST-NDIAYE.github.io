---
import { linkedin, github } from '../data/liens';

const email = 'dstndiaye@gmail.com';
---

<footer class="mx-auto flex max-w-page flex-wrap items-center justify-between gap-4 border-t border-line px-5 py-8 sm:px-8 text-[15px] text-muted">
  <span class="font-display font-bold text-ink">Serigne Bassirou Ndiaye</span>
  <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
    <a class="font-mono text-sm" href={`mailto:${email}`}>{email}</a>
    <a class="font-semibold" href={linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (nouvel onglet)">LinkedIn</a>
    <a class="font-semibold" href={github} target="_blank" rel="noopener noreferrer" aria-label="GitHub (nouvel onglet)">GitHub</a>
  </div>
</footer>
